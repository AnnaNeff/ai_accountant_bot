# Copy this file to .env and fill in private values.
#
# Local run:
# DATABASE_URL points to localhost because PostgreSQL is published on the host.
#
# Docker Compose run:
# docker-compose.yml overrides DATABASE_URL for the bot container so it connects
# to the db service instead of localhost.
TELEGRAM_BOT_TOKEN=
ALLOWED_TELEGRAM_USER_IDS=
DATABASE_URL=postgresql+asyncpg://ai_accountant:ai_accountant@localhost:5432/ai_accountant
LOG_LEVEL=INFO
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
DOCUMENT_STORAGE_PATH=data/private/documents
OCR_LANGUAGES=eng
